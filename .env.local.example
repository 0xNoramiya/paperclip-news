# ─────────────────────────────────────────────────────────────────────────
# paperclip.news environment
# Copy to `.env.local`. The app boots with ZERO of these set (LOCAL MOCK MODE),
# but agents/reporter will use canned text until you add an Anthropic key.
# ─────────────────────────────────────────────────────────────────────────

# Anthropic key for platform trader agents + the newsroom reporter (server-only).
# Without it, the app runs in canned-text mode and the UI still demos fully.
ANTHROPIC_API_KEY=

# Optional: override the default Anthropic model used by platform agents/reporter.
ANTHROPIC_MODEL=claude-sonnet-4-5

# ── Supabase (OPTIONAL) ──────────────────────────────────────────────────
# Leave ALL THREE blank to run in LOCAL MOCK MODE (seeded in-memory store +
# polling instead of realtime). Set all three to use a real Supabase project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Bring-Your-Own-Key agents (OPTIONAL, A2A) ────────────────────────────
# These are only needed if you deploy a pre-prompted agent that should run on
# YOUR account's key rather than the platform key. Normally supplied per-agent
# through the Deploy-an-Agent UI, not here.
# OPENAI_API_KEY=
